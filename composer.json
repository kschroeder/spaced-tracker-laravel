{
    "name": "kschroeder/spaced-tracker-laravel",
    "description": "Laravel service provider, facade, and configuration for the Space-Track client.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "keywords": ["laravel", "satellites", "space-track", "spacetrack", "tle"],
    "require": {
        "php": "^8.2",
        "illuminate/config": "^11.0 || ^12.0 || ^13.0",
        "illuminate/container": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "kschroeder/spaced-tracker": "^1.0",
        "nyholm/psr7": "^1.8",
        "psr/http-client": "^1.0",
        "psr/log": "^3.0",
        "vlucas/phpdotenv": "^5.6.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/kschroeder/spaced-tracker"
        }
    ],
    "suggest": {
        "guzzlehttp/guzzle": "PSR-18 client used when the container has none and symfony/http-client is not installed.",
        "symfony/http-client": "PSR-18 client used when the container does not already have one. Enables multiplexed batches."
    },
    "autoload": {
        "psr-4": {
            "SpacedTracker\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SpacedTracker\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SpacedTracker\\Laravel\\SpacedTrackerServiceProvider"
            ],
            "aliases": {
                "SpacedTracker": "SpacedTracker\\Laravel\\SpacedTracker"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs",
        "stan": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    }
}
